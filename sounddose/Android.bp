cc_library_shared {
    name: "libpal_sounddose",
    owner: "qti",
    vendor: true,

    srcs: ["src/SoundDoseUtility.cpp"],

    export_include_dirs: ["inc"],
    include_dirs: [
        "system/media/audio/include",
        "system/media/audio_route/include",
    ],

    header_libs: [
        "libacdb_headers",
        "libagm_headers",
        "libarmemlog_headers",
        "libarosal_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libsession_agm_headers",
        "libsession_ar_headers",
        "libspf-headers",
    ],

    shared_libs: [
        "libar-pal",
        "libaudioroute",
        "libcutils",
        "libexpat",
        "liblog",
        "libsession_agm",
        "libsession_ar",
        "libtinyalsa",
    ],
}

cc_library_headers {

    name: "libstream_acd_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libstream_acd",
    owner: "qti",
    vendor: true,

    cflags: ["-DACD_SM_FILEPATH=\"/vendor/etc/models/acd/\""] + select(soong_config_variable("qtiaudio", "feature_ar_memlogger"), {
        "true": [],
        default: ["-DPAL_MEMLOG_UNSUPPORTED"],
    }),
    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: [
        "src/ACDEngine.cpp",
        "src/ContextDetectionEngine.cpp",
        "src/StreamACD.cpp",
    ],

    local_include_dirs: ["inc"],
    include_dirs: ["system/media/audio_route/include"],

    header_libs: [
        "libacdb_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libsession_ar_headers",
        "libspf-headers",
        "libvui_dmgr_headers",
    ] + select(soong_config_variable("qtiaudio", "feature_ar_memlogger"), {
        "true": ["libarmemlog_headers"],
        default: [],
    }),

    shared_libs: [
        "libar-gsl",
        "libar-pal",
        "libcutils",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libsession_ar",
    ],
}

cc_library_headers {

    name: "libstream_commonproxy_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libstream_commonproxy",
    owner: "qti",
    vendor: true,

    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: ["src/StreamCommonProxy.cpp"],

    local_include_dirs: ["inc"],
    include_dirs: ["system/media/audio_route/include"],

    header_libs: [
        "libacdb_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libspf-headers",
        "libstream_common_headers",
        "libvui_dmgr_headers",
    ] + select(soong_config_variable("qtiaudio", "feature_ar_memlogger"), {
        "true": ["libarmemlog_headers"],
        default: [],
    }),

    shared_libs: [
        "libar-pal",
        "libcutils",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libstream_common",
    ],
}

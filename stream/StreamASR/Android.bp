cc_library_headers {

    name: "libstream_asr_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libstream_asr",
    owner: "qti",
    vendor: true,


    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: [
        "src/ASREngine.cpp",
        "src/StreamASR.cpp",
    ],

    local_include_dirs: ["inc"],
    include_dirs: ["system/media/audio_route/include"],

    header_libs: [
        "libacdb_headers",
        "libarmemlog_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libsession_ar_headers",
        "libspf-headers",
        "libvui_dmgr_headers",
    ],

    shared_libs: [
        "libar-gsl",
        "libar-pal",
        "libcutils",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libsession_ar",
    ],
}

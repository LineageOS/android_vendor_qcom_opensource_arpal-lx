cc_library_headers {

    name: "libsession_pcm_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libsession_pcm",
    owner: "qti",
    vendor: true,

    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: ["src/SessionAlsaPcm.cpp"],

    local_include_dirs: ["inc"],
    include_dirs: ["system/media/audio_route/include"],

    header_libs: [
        "libacdb_headers",
        "libagm_headers",
        "libarmemlog_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libsession_ar_headers",
        "libspf-headers",
    ],

    shared_libs: [
        "libagmclient",
        "libar-pal",
        "libaudioroute",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libsession_ar",
        "libtinyalsa",
        "libtinycompress",
    ],
}

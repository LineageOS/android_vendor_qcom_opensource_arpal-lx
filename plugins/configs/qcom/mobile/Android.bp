cc_library_headers {
    name: "libsession_compress_config_headers",
    vendor: true,

    export_include_dirs: select(soong_config_variable("ANDROID", "target_board_platform"), {
        "sun": ["sun/ConfigSessionAlsaCompress/inc"],
        default: ["default/ConfigSessionAlsaCompress/inc"],
    }),
}

cc_library_headers {
    name: "libsession_pcm_config_headers",
    vendor: true,

    export_include_dirs: select(soong_config_variable("ANDROID", "target_board_platform"), {
        "sun": ["sun/ConfigSessionAlsaPcm/inc"],
        default: ["default/ConfigSessionAlsaPcm/inc"],
    }),
}


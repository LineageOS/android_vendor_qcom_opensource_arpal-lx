cc_library_shared {
    name: "lib_bt_bundle",

    srcs: [
        "bt_base.c",
        "bt_bundle.c",
    ],

    cflags: [
        "-O2",
        "-fvisibility=hidden",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],

    include_dirs: ["system/media/audio/include"],

    header_libs: [
        "libarosal_headers",
        "libspf-headers",
    ],

    owner: "qti",
    vendor: true,
}


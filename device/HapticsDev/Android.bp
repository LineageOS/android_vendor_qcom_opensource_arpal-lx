cc_library_headers {

    name: "libdev_haptics_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libdev_haptics",
    owner: "qti",
    vendor: true,

    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: [
        "src/HapticsDev.cpp",
        "src/HapticsDevProtection.cpp",
    ],

    local_include_dirs: ["inc"],
    include_dirs: [
        "system/media/audio/include",
        "system/media/audio_route/include",
    ],

    header_libs: [
        "libacdb_headers",
        "libagm_headers",
        "libarmemlog_headers",
        "libarosal_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "libdev_speaker_headers",
        "liblisten_headers",
        "libsession_ar_headers",
        "libspf-headers",
    ],

    shared_libs: [
        "libar-pal",
        "libaudioroute",
        "libcutils",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libsession_ar",
        "libtinyalsa",
        "libtinycompress",
        "libutilscallstack",
    ],
}

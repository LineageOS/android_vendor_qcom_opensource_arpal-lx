cc_library_headers {

    name: "libdev_bt_headers",
    export_include_dirs: ["inc"],
    vendor: true,

}

cc_library_shared {
    name: "libdev_bt",
    owner: "qti",
    vendor: true,

    cflags: ["-DA2DP_SINK_SUPPORTED"],
    cppflags: ["-fexceptions"],
    rtti: true,

    srcs: ["src/Bluetooth.cpp"],

    local_include_dirs: ["inc"],
    include_dirs: [
        "system/media/audio/include",
        "system/media/audio_route/include",
    ],

    header_libs: [
        "libacdb_headers",
        "libagm_headers",
        "libarosal_headers",
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libsession_ar_headers",
        "libspf-headers",
    ] + select(soong_config_variable("qtiaudio", "feature_ar_memlogger"), {
        "true": ["libarmemlog_headers"],
        default: [],
    }),

    shared_libs: [
        "libar-pal",
        "libcutils",
        "libexpat",
        "liblog",
        "liblx-osal",
        "libpal_sounddose",
        "libsession_ar",
        "libtinyalsa",
        "libtinycompress",
        "libutilscallstack",
    ],
}
